{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>adfinis/renovate-config",
    "github>adfinis/renovate-config:app",
    "github>adfinis/renovate-config:quiet",
    "github>adfinis/renovate-config:lockfile-maintenance",
    "github>projectpotos/renovate-config:potos-deps"
  ],
  "pip-compile": {
    "managerFilePatterns": ["/^src\\/firstboot\\/requirements\\.txt$/"]
  },
  "pip_requirements": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Keep Fedora 44",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["fedora", "docker.io/library/fedora"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "enabled": false
    }
  ]
}
